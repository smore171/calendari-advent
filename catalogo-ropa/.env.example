# Copia a .env (local) — NUNCA subas .env al repo.
# Clasificador IA opcional (solo fotos dudosas)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_THRESHOLD=0.6

# Cloudflare R2 (fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=catalogo-media

# Secrets de Pages Functions: se configuran en Cloudflare (Settings → Variables) o en .dev.vars
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
